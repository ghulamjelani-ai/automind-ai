# Copy to model_server/.env when running the server yourself.
# The Colab notebook sets these for you.

# Shared secret. Put the same value in backend/.env as MODEL_SERVER_API_KEY.
MODEL_SERVER_API_KEY=change-me-to-a-long-random-string

# Hugging Face token. Mistral models are gated: accept the terms on the model page first.
HF_TOKEN=

TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
TEXT_ADAPTER=training/output/mistral-marketing-lora
# auto | 4bit | fp16
TEXT_PRECISION=auto

IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
IMAGE_LORA=training/output/sd15-brand-lora
IMAGE_LORA_SCALE=0.8
IMAGE_LORA_TRIGGER=
IMAGE_STEPS=28
IMAGE_GUIDANCE=7.0
IMAGE_SIZE=512
IMAGE_UPSCALE=2
IMAGE_SAFETY_CHECKER=true

LOAD_TEXT=true
LOAD_IMAGE=true
