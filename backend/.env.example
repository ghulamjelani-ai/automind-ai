APP_NAME=Marketing AI Backend
FRONTEND_URL=http://localhost:5173

# Firebase Admin
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=marketing_ai_db
DB_USER=marketing_ai_user
DB_PASSWORD=your_database_password

# Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# GPU model server: Mistral 7B + Stable Diffusion 1.5.
# The last cell of colab/MarketingAI_GPU.ipynb prints both lines.
MODEL_SERVER_URL=https://your-tunnel.trycloudflare.com
MODEL_SERVER_API_KEY=printed_by_the_notebook
# Seconds to wait for one model call (keep under 100 with a Cloudflare tunnel)
MODEL_SERVER_TIMEOUT=95
